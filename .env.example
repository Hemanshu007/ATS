DATABASE_URL=postgresql+asyncpg://ats:ats_secret@db:5432/ats_db
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=/app/uploads

# Fastmail SMTP
SMTP_HOST=smtp.fastmail.com
SMTP_PORT=587
SMTP_USER=your-email@fastmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=your-email@fastmail.com

# AWS S3 (for resume storage)
AWS_ACCESS_KEY_ID=your-iam-access-key
AWS_SECRET_ACCESS_KEY=your-iam-secret-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=ats-resumes-yourname

# Email transport: "smtp", "ses", or "" (disabled/log only)
EMAIL_TRANSPORT=

# Redis / Celery
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1

# OpenAI (for resume parsing + embeddings)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
